# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# PostgreSQL connection string
# Local: postgres://user:password@localhost:5432/discipline
# Render: postgres://user:password@host:5432/discipline (provided by Render)
DATABASE_URL=postgres://postgres:password@localhost:5432/discipline

# Server port (Render sets this automatically)
PORT=3000

# Environment: development | production
NODE_ENV=development

# Path to the CSV data (relative to scripts/ folder, or absolute)
# Default points to the Notion export inside the project folder
# CSV_PATH=../../ExportBlock-1a7353fa-f792-4867-97c5-8c602036ccd9-Part-1/DISCIPLINE/DISCIPLINE c78e8d8d089782eea1450154c952a8f0_all.csv
